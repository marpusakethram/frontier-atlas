# =============================================================================
# FRONTIER ATLAS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env: cp .env.example .env
# Never commit real API credentials to version control.
# =============================================================================

# Database connection string (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/frontier_atlas

# Google Gemini API (Official google-genai SDK — Free-tier eligible model only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Public Research & Open-Source Connectors (Optional keys increase rate limits)
OPENALEX_API_KEY=
GITHUB_TOKEN=
ARXIV_USER_AGENT=FrontierAtlas/1.0 (https://github.com/frontier-atlas; mailto:research@frontier-atlas.org)

# Application Runtime & Networking
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# AI Budget & Rate Controls (Conservative free-tier budgets)
ENABLE_AI=true
AI_MAX_REQUESTS_PER_DAY=100
AI_MAX_REQUESTS_PER_RUN=8
AI_MAX_REQUESTS_PER_MINUTE=5

# Optional Local Write-Endpoint API Key (for non-localhost deployments)
API_WRITE_TOKEN=
